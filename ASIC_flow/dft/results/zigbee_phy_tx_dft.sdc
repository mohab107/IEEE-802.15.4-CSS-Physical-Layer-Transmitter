###################################################################

# Created by write_sdc on Fri Sep 18 09:41:11 2026

###################################################################
set sdc_version 2.1

set_units -time ns -resistance MOhm -capacitance fF -voltage V -current uA
set_wire_load_model -name ForQA -library saed90nm_max
set_max_transition 1 [current_design]
set_max_capacitance 50 [current_design]
set_max_fanout 3 [current_design]
set_driving_cell -lib_cell IBUFFX2 [get_ports reset]
set_driving_cell -lib_cell IBUFFX2 [get_ports scan_rst]
set_driving_cell -lib_cell IBUFFX2 -library saed90nm_max [get_ports test_mode]
set_driving_cell -lib_cell IBUFFX2 -library saed90nm_max [get_ports SI]
set_driving_cell -lib_cell IBUFFX2 -library saed90nm_max [get_ports SE]
set_driving_cell -lib_cell IBUFFX2 [get_ports start_Tx]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payloadLength[7]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payloadLength[6]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payloadLength[5]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payloadLength[4]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payloadLength[3]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payloadLength[2]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payloadLength[1]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payloadLength[0]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_din[7]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_din[6]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_din[5]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_din[4]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_din[3]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_din[2]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_din[1]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_din[0]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_addr[7]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_addr[6]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_addr[5]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_addr[4]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_addr[3]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_addr[2]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_addr[1]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports {payload_addr[0]}]
set_driving_cell -lib_cell IBUFFX2 [get_ports payload_wr_en]
set_load -pin_load 0.1 [get_ports SO]
set_load -pin_load 5 [get_ports done_Tx]
set_load -pin_load 5 [get_ports {Tx_real[7]}]
set_load -pin_load 5 [get_ports {Tx_real[6]}]
set_load -pin_load 5 [get_ports {Tx_real[5]}]
set_load -pin_load 5 [get_ports {Tx_real[4]}]
set_load -pin_load 5 [get_ports {Tx_real[3]}]
set_load -pin_load 5 [get_ports {Tx_real[2]}]
set_load -pin_load 5 [get_ports {Tx_real[1]}]
set_load -pin_load 5 [get_ports {Tx_real[0]}]
set_load -pin_load 5 [get_ports {Tx_imag[7]}]
set_load -pin_load 5 [get_ports {Tx_imag[6]}]
set_load -pin_load 5 [get_ports {Tx_imag[5]}]
set_load -pin_load 5 [get_ports {Tx_imag[4]}]
set_load -pin_load 5 [get_ports {Tx_imag[3]}]
set_load -pin_load 5 [get_ports {Tx_imag[2]}]
set_load -pin_load 5 [get_ports {Tx_imag[1]}]
set_load -pin_load 5 [get_ports {Tx_imag[0]}]
set_load -pin_load 5 [get_ports sample_valid]
set_case_analysis 1 [get_ports test_mode]
set_ideal_network [get_ports clk]
set_ideal_network [get_ports reset]
set_ideal_network [get_ports scan_clk]
set_ideal_network [get_ports scan_rst]
set_ideal_network [get_ports test_mode]
set_ideal_network [get_ports SE]
create_clock [get_ports clk]  -period 31.25  -waveform {0 15.625}
set_clock_uncertainty -setup 1.25  [get_clocks clk]
set_clock_uncertainty -hold 0.7  [get_clocks clk]
create_clock [get_ports scan_clk]  -name DFT_CLK  -period 100  -waveform {45 55}
set_clock_uncertainty -setup 0.025  [get_clocks DFT_CLK]
set_clock_uncertainty -hold 0.01  [get_clocks DFT_CLK]
set_input_delay -clock clk  -max 2  [get_ports reset]
set_input_delay -clock clk  -max 2  [get_ports scan_rst]
set_input_delay -clock DFT_CLK  30  [get_ports test_mode]
set_input_delay -clock DFT_CLK  30  [get_ports SI]
set_input_delay -clock DFT_CLK  30  [get_ports SE]
set_input_delay -clock clk  -max 2  [get_ports start_Tx]
set_input_delay -clock clk  -max 2  [get_ports {payloadLength[7]}]
set_input_delay -clock clk  -max 2  [get_ports {payloadLength[6]}]
set_input_delay -clock clk  -max 2  [get_ports {payloadLength[5]}]
set_input_delay -clock clk  -max 2  [get_ports {payloadLength[4]}]
set_input_delay -clock clk  -max 2  [get_ports {payloadLength[3]}]
set_input_delay -clock clk  -max 2  [get_ports {payloadLength[2]}]
set_input_delay -clock clk  -max 2  [get_ports {payloadLength[1]}]
set_input_delay -clock clk  -max 2  [get_ports {payloadLength[0]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_din[7]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_din[6]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_din[5]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_din[4]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_din[3]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_din[2]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_din[1]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_din[0]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_addr[7]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_addr[6]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_addr[5]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_addr[4]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_addr[3]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_addr[2]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_addr[1]}]
set_input_delay -clock clk  -max 2  [get_ports {payload_addr[0]}]
set_input_delay -clock clk  -max 2  [get_ports payload_wr_en]
set_output_delay -clock DFT_CLK  30  [get_ports SO]
set_output_delay -clock clk  -max 2  [get_ports done_Tx]
set_output_delay -clock clk  -max 2  [get_ports {Tx_real[7]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_real[6]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_real[5]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_real[4]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_real[3]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_real[2]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_real[1]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_real[0]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_imag[7]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_imag[6]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_imag[5]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_imag[4]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_imag[3]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_imag[2]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_imag[1]}]
set_output_delay -clock clk  -max 2  [get_ports {Tx_imag[0]}]
set_output_delay -clock clk  -max 2  [get_ports sample_valid]
set_clock_groups  -logically_exclusive -name clk_1  -group [get_clocks clk]    \
-group [get_clocks DFT_CLK]
